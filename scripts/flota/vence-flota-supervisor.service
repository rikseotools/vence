# scripts/flota/vence-flota-supervisor.service — el supervisor continuo, como servicio. (T-617)
#
# ── POR QUÉ EXISTE ──────────────────────────────────────────────────────────────────────────
# El programador (`flota.cjs bucle`) estaba escrito y NO CORRÍA EN NINGÚN SITIO: era un proceso
# en primer plano que alguien tenía que lanzar a mano en el portátil de Manuel y mantener vivo.
# Consecuencia medida el 06/08: los cuatro trabajadores del VPS ociosos SIETE HORAS, con los
# últimos encargos escritos a las 11:17 — y el commit que traía el bucle es de las 11:35. Se
# construyó el motor y no se arrancó.
#
# ── POR QUÉ EN EL VPS Y NO EN EL PORTÁTIL ───────────────────────────────────────────────────
# Porque el portátil se cierra. Un supervisor que solo vive mientras Manuel tiene la tapa abierta
# reproduce exactamente el fallo que viene a arreglar: la flota trabaja mientras alguien mira.
# El VPS ya está encendido siempre — es donde viven los trabajadores.
#
# ── QUÉ NO HACE, Y ES A PROPÓSITO ───────────────────────────────────────────────────────────
# No responde preguntas del embudo, no aprueba borradores, no envía nada a ninguna persona y no
# toca las sesiones de Manuel. Reparte trabajo y relanza turnos muertos. Todo lo que sale hacia
# una persona sigue pasando por él (`lib/sessions/aprobacion.cjs`).
#
# ── INSTALAR ────────────────────────────────────────────────────────────────────────────────
#   scp scripts/flota/vence-flota-supervisor.service root@<vps>:/etc/systemd/system/
#   ssh root@<vps> 'systemctl daemon-reload && systemctl enable --now vence-flota-supervisor'
#   ssh root@<vps> 'journalctl -u vence-flota-supervisor -f'     # ver las pasadas
#
# Necesita `/etc/vence-flota/supervisor.env` con DATABASE_URL (la credencial de coordinación) y
# VENCE_FLOTA_AQUI=flota-1 — esa variable es la que le dice que los trabajadores w1-w4 son SUYOS
# y sus comandos van sin SSH (`lib/flota/maquinas.cjs`, `esLocal`). Sin ella se declararía remoto
# a sí mismo e intentaría entrar por SSH en su propia máquina.

[Unit]
Description=Supervisor continuo de la flota de Vence (reparte trabajo y relanza turnos muertos)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flota
Group=flota
EnvironmentFile=/etc/vence-flota/supervisor.env
WorkingDirectory=/home/flota/vence
ExecStart=/usr/bin/node /home/flota/vence/scripts/flota/flota.cjs bucle --cada 300

# El bucle ya aísla el fallo de UNA pasada (no se muere por un SSH caído), así que un reinicio
# aquí solo ocurre si se cae el proceso entero. 30 s para no entrar en bucle de reinicios contra
# una BD caída.
Restart=always
RestartSec=30

# Salida limpia: el propio bucle atiende SIGTERM para no dejar un `repartir` huérfano lanzando
# encargos que nadie vigila. Se le da margen para terminar la pasada en curso.
KillSignal=SIGTERM
TimeoutStopSec=120

# ── EL COORDINADOR NO PUEDE SER LA VÍCTIMA (T-647, 07/08/2026) ──────────────────────────────
# El 07/08 el kernel lo mató DOS VECES por falta de memoria (`Failed with result 'oom-kill'`), y
# no por gastar él: los turnos de los trabajadores colgaban de SU cgroup, así que el consumo de
# ellos se le atribuía a él. Eso ya está arreglado por la raíz —los turnos los levanta systemd y
# viven en el cgroup de su propio trabajador—, pero el blindaje se queda igualmente: si un día
# vuelve a faltar memoria, que muera un turno y no quien es capaz de levantarlo después. Un
# trabajador muerto lo resucita el supervisor; un supervisor muerto no lo resucita nadie hasta
# que alguien mire.
OOMScoreAdjust=-800
MemoryAccounting=yes

# Un supervisor no necesita escribir en ningún sitio del sistema salvo su propio HOME.
NoNewPrivileges=yes

# ── ⚠️ SIN `PrivateTmp`, Y NO ES UN DESCUIDO (T-647, 07/08/2026) ─────────────────────────────
# Los sockets de tmux viven en `/tmp/tmux-<uid>/`. Con `PrivateTmp=yes` el supervisor tiene su
# PROPIO /tmp y **deja de ver los de sus trabajadores** en cuanto los crea systemd (antes no se
# notaba porque el servidor de tmux lo arrancaba él mismo, dentro de su /tmp privado). Medido al
# separar los servidores por trabajador: el supervisor empezó a decir «no se pudo ver qué está
# ejecutando su panel» de los cuatro y dejó de repartir — una flota entera parada por un ajuste
# de seguridad que no protegía nada aquí. Si algún día se quiere recuperar el aislamiento, la vía
# NO es volver a ponerlo: es un directorio de sockets compartido y explícito para los dos lados.
PrivateTmp=no

[Install]
WantedBy=multi-user.target
