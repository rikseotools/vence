#!/bin/sh
# .husky/pre-commit
# Pre-commit hook — solo tests rápidos (unit + critical validations) + lint.
#
# Tests de integración / perf / security / scraping → corren en CI (.github/workflows/test.yml).
# Patrón estándar (test pyramid): pre-commit local <30s, CI completo en cada PR.
# Ver docs/ARCHITECTURE_ROADMAP.md sección «Plan de ejecución activo» bloque 2.

echo "🔍 Ejecutando validaciones pre-commit..."
echo ""

# 1. Verificar schema drift (solo si DATABASE_URL disponible — no bloquea).
#    `.husky/_/h` invoca este script con `sh -e` (ver ese fichero): CUALQUIER comando de la lista
#    que falle sin ir dentro de un `if`/`&&`/`||` mata el hook entero ahí mismo, saltándose incluso
#    la línea que captura `$?`. El comentario de arriba prometía "no bloquea" y `-e` lo desmentía en
#    silencio: bastaba con que `npm run db:check` no pudiera CONECTAR (blindado con `|| true`) para
#    que el commit muriera antes de imprimir el aviso de "Schema desincronizado". Medido 05/08 con
#    un rol de BD restringido (vence_coordinacion, T-539): pg_hba rechaza la conexión sin TLS y el
#    hook abortaba en la línea 15, sin llegar ni a la sintaxis ni al resto de comprobaciones.
if [ -n "$DATABASE_URL" ]; then
  echo "📊 Verificando sincronización schema vs BD..."
  npm run db:check || true
  SCHEMA_EXIT_CODE=$?

  if [ $SCHEMA_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "⚠️  Schema desincronizado. Ver errores arriba."
    echo "   Para sincronizar: npm run db:pull"
    echo ""
    # Solo warning, no bloquea el commit
  fi
else
  echo "⏭️  Saltando verificación de schema (DATABASE_URL no configurada)"
fi

echo ""
# 1a. Sintaxis de lo que se commitea (T-349). Es lo primero porque es lo más barato (milisegundos)
#     y lo que más caro sale si pasa: un fichero que no parsea pone el CI en rojo y con él el
#     deploy de TODAS las sesiones. Ha pasado 3 veces con el mismo modo de fallo (backticks de
#     markdown dentro de un template literal). Detalle y escape: lib/calidad/sintaxisStaged.cjs.
node scripts/check-sintaxis-staged.cjs
if [ $? -ne 0 ]; then
  echo "❌ Commit cancelado por error de sintaxis (ver arriba)."
  exit 1
fi

# 1b. Una sesión por índice de git (T-415). Va aquí arriba, con lo barato, porque lo que evita es
#     IRREVERSIBLE en la historia: el índice es del REPOSITORIO, así que si dos sesiones trabajan
#     en el mismo directorio, el `git add` de una entra en el commit de la otra sin que ni ellas
#     ni git puedan saberlo. Pasó el 31/07: el trabajo de una sesión acabó en main bajo el mensaje
#     de otra. Solo bloquea si hay OTRA sesión viva en ESTE directorio; una sola es lo normal.
node scripts/check-indice-compartido.cjs
if [ $? -ne 0 ]; then
  exit 1
fi

# 1b-bis. Recordatorio de método cuando el commit ESTRENA ficheros (T-495): es el momento exacto
#     en que aplica «¿ya existe?», y el que imprime `claim` lleva horas sepultado. NO bloquea
#     nunca —es un recordatorio— y calla si el commit solo modifica cosas que ya existían.
node scripts/sessions/recordar-metodo.cjs --staged || true

echo ""
# 1b. Drift de display del temario (título ↔ descripcion_corta/epigrafe/description).
#     Caza el fallo del 08/07/2026 (re-scope Cantabria a Win11/365 que dejó la
#     descripcion_corta stale/desalineada). El self-test es puro (sin BD, rápido);
#     el audit contra BD solo si DATABASE_URL está disponible. BLOQUEA en 🔴.
echo "🔎 Verificando drift de display del temario (audit:display-drift)..."
npm run audit:display-drift -- --selftest
if [ $? -ne 0 ]; then
  echo "❌ audit:display-drift: el self-test del detector falló (lógica rota). Commit cancelado."
  exit 1
fi
if [ -n "$DATABASE_URL" ]; then
  npm run audit:display-drift
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Drift título ↔ descripcion_corta/epigrafe en el temario (ver 🔴 arriba)."
    echo "   Al modificar un tema, actualiza los 4 campos: title + epigrafe + description + descripcion_corta."
    echo "   Detalle: docs/maintenance/verificar-epigrafe-topic-scope.md"
    exit 1
  fi
else
  echo "⏭️  Saltando audit:display-drift contra BD (DATABASE_URL no configurada)"
fi

echo ""
# Escape con NOMBRE (28/07/2026). Antes este hook no tenía ninguno, y como corre la suite
# ENTERA, un test roto por OTRA sesión bloquea a todo el mundo — incluido un commit de solo
# documentación. Sin escape nombrado, la salida era `--no-verify`, que apaga TAMBIÉN el
# `db:check` y el `audit:display-drift` de arriba. Este salta solo los tests, deja rastro en
# la salida y no toca los demás guardarraíles.
if [ "${PRECOMMIT_TESTS_SKIP:-}" = "1" ]; then
  echo "⏭️  Tests saltados (PRECOMMIT_TESTS_SKIP=1) — el resto de validaciones SÍ se han pasado."
  echo "   Úsalo solo si el rojo NO es tuyo; si lo es, arréglalo (el CI lo va a cazar igual)."
else
echo "🧪 Tests críticos + unit..."
npm run test:precommit && npm run test:unit
TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ Tests fallaron. Commit cancelado."
  echo ""
  echo "💡 Para solucionar:"
  echo "   1. Revisa los tests con: npm run test:unit"
  echo "   2. Tests de integración (BD real / flaky) corren en CI, no aquí."
  echo "   3. Corrige los problemas y vuelve a hacer commit."
  echo ""
  echo "🤔 ¿Y si el rojo NO es tuyo? Con varias sesiones pasa: compruébalo guardando tus"
  echo "   cambios y corriendo la suite sobre HEAD limpio:"
  echo "       git stash push -u && npm run test:unit; git stash pop"
  echo "   (ojo: el stash es del REPO, no del worktree — con sesiones en paralelo, haz pop"
  echo "    enseguida). Si ya estaba roto ANTES de tus cambios, avisa a quien lo rompió y"
  echo "   sigue con:  PRECOMMIT_TESTS_SKIP=1 git commit …"
  echo "   Eso salta SOLO los tests; NO uses --no-verify, que apaga además el db:check y el"
  echo "   audit:display-drift."
  echo ""
  exit 1
fi
fi

# Lint NO se ejecuta en pre-commit:
#   - El config de eslint (next/core-web-vitals) referencia reglas de
#     @typescript-eslint que no están instaladas → 427 errores
#     pre-existentes del proyecto, no de los cambios.
#   - Lint completo corre en CI (.github/workflows/test.yml job 'lint').
#   - Patrón estándar: Next.js, React, PostHog usan lint-staged o lint
#     solo en CI — no lint completo en pre-commit local.
#   - Cuando se arregle el config (tarea separada del Bloque 2), valorar
#     añadir lint-staged sobre archivos modificados.

echo ""
echo "✅ Pre-commit OK. Lint + tests de integración correrán en CI."
